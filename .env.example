# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mini-project-manager?retryWrites=true&w=majority

# Long random string, min 32 chars. Example: openssl rand -base64 48
JWT_SECRET=super-secret-jwt-key-with-at-least-32-characters-minimum-length-requirement

# Token expiration period (default 7d)
JWT_EXPIRES_IN=7d

# Public base URL (used for absolute links if needed)
NEXT_PUBLIC_APP_URL=http://localhost:3000
